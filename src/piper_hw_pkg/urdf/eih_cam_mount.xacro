<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper_with_eih_cam">
  <!-- 젯슨 워크스페이스에 agilexrobotics/piper_ros(humble 브랜치)의 piper_description
       패키지가 같이 빌드돼 있어야 $(find piper_description)이 풀린다 — 인수인계 문서 참고. -->
  <xacro:include filename="$(find piper_description)/urdf/piper_description.xacro"/>

  <link name="eih_cam"/>
  <joint name="eih_cam_mount_joint" type="fixed">
    <parent link="link6"/>
    <child link="eih_cam"/>
    <!-- TODO(실측 필요): 지금은 0,0,0 자리표시자 — 실제 손목캠 장착 위치/자세로 갱신할 것.
         sim의 EIH_MOUNT_POS/EIH_MOUNT_QUAT_WXYZ(common_pkg/step22_common.py)는 참고용
         출발점일 뿐, 실제 마운트 브라켓이 다르면 그대로 못 쓴다. -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
